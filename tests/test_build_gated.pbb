|{ include, args = { repo, ... }, ... }|
let
    lib = include "${repo}/lead-lib.pbb" { };
    config = |self| {
        config = { arch = "arch_b"; };
        common = { out = self.c.inc; };
    };
    mod_a = |self| { c = { inc = ["var_a"]; }; };
    mod_b = |self| { c = { inc = ["var_b"]; }; };
    mods = [
        config,
        (lib.gate (|self| self.config.arch == "arch_a") mod_a),
        (lib.gate (|self| self.config.arch == "arch_b") mod_b),
    ];
in
(lib.build mods) == ["var_b"]