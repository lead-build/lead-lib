|{ include, args = { repo, ... }, ... }|
let
    lib = include "${repo}/lead-lib.pbb" { };

    mod_a = {
        c = {
            cmd_cc = | l | "cc_a";
        };
    };
    mod_b = {
        c = {
            cmd_cc = | l | "cc_b";
        };
    };

    mods = lib.merge [ mod_a, mod_b, ];
in
(mods.c.cmd_cc mods == "cc_b") &&
(mod_a.c.cmd_cc mod_a == "cc_a") &&
(mod_b.c.cmd_cc mod_b == "cc_b")