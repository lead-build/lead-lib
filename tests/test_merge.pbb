|{ include, args = { repo, ... }, ... }|
let
    lib = include "${repo}/lead-lib.pbb" { };

    mod_a = | l |{
        c = {
            cmd_cc = "cc_a";
            inc = [ "inc_a" ];
        };
    };
    mod_b = | l |{
        c = {
            cmd_cc = "cc_b";
            inc = [ "inc_b" ];
        };
    };

    mods = lib.merge [ mod_a, mod_b, ];
in
((mods mods).c.cmd_cc == "cc_b") &&
((mod_a mod_a).c.cmd_cc == "cc_a") &&
((mod_b mod_b).c.cmd_cc == "cc_b") &&
((mods mods).c.inc == [ "inc_a", "inc_b" ]) &&
((mod_a mod_a).c.inc == [ "inc_a" ]) &&
((mod_b mod_b).c.inc == [ "inc_b" ])