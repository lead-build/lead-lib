|{ cwd, include, ... }|
let
    lib = include "${cwd}/lib/lib.pbb";

    target = {
        config = {
            objdir = ["${cwd}/build"];
            srcdir = ["${cwd}"];
            app = ["${cwd}/my_app"];
        };
    };

    app = {
        c = {
            srcs = [
                "${cwd}/main.c",
                "${cwd}/model/model.c",
                "${cwd}/model/some_other_model.c",
            ];
            incs = [
                "${cwd}/model",
            ];
        };
    };

    all_modules = lib.merge [
        target,
        app,
    ];
in
(lib.c.build all_modules)