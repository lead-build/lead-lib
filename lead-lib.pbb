|{ include, cwd, ... }|
|{
    languages ? { },
    ...
}|
let
    lang = include (cwd / "lang" / "lang.pbb") {
        languages = languages;
    };

    tk = include (cwd / "tools" / "toolkit.pbb");

    reloc = | config module |
    let
        obj = build config module;
    in
    |{ ... }|
    {
        target = (module config).target;
        inc = (module config).inc;
        obj = |{ ... }| obj;
    };

in
{
    build = lang.build;
    reloc = reloc;
    merge = lang.merge;
    tk = tk;
}