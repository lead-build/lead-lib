|{ include, cwd, ... } { languages ? { }, ... }|
let
    lang = include (cwd / "lang" / "lang.pbb") { languages = languages; };
    tk = include (cwd / "tools" / "toolkit.pbb");
in
{
    combine = lang.combine;
    build = lang.build;
    merge = lang.merge;
    test_multi_report = lang.test_multi_report;
    test_report = lang.test_report;
    lang = lang.export;
    gate = lang.gate;
    tk = tk;
}