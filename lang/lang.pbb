|{ include, cwd, ... }|
|{
    languages = ext_langs,
    ...
}|
let

     # Add predefined langauges
    languages = {
        common = include "${cwd}/common/common.pbb";
        c = include "${cwd}/c/c.pbb";
        rust = include "${cwd}/rust/rust.pbb";
    } // ext_langs;

    do_merge = | field mergefnc a b | (
        switch (a ? field, b ? field) {
            (true, true) => mergefnc a.{ field } b.{ field };
            (true, false) => a.{ field };
            (false, true) => b.{ field };
        }
    );

    merge_two = | a b |
    {
        | (lang, def) |
        let
            lang_merge = | alang blang |{
                | (field, mergefnc) |
                (field, do_merge field mergefnc alang blang)
                for (def.merge)
                if | (field, _) | alang ? field || blang ? field
            };
        in
        (lang, do_merge lang lang_merge a b)
        for languages
        if | (lang, _) | a ? lang || b ? lang
    };

    merge = | mods l | (| acc mod | merge_two acc (mod l) for { }..mods);

    base = merge [
        | (_, def) |
        def.base
        for languages
    ];

    build = | mods | let
        all = merge ([ base ] ++ mods);
    in (
        (all all).common.out
    );

    export = {
        | (lang, def) | (lang, def.export)
        for languages
        if | (_, def) | def ? "export"
    };

    gate = | cond mod l |
    {
        | (k, v) | (
            k,
            switch (cond (l l)) {
                false => { };
                true => v;
            }
        )
        for (mod l)
    };
in
{
    merge = merge;
    build = build;
    export = export;
    gate = gate;
}