|{ include, cwd, ops, ... } { languages, ... }|
let
    # Add predefined langauges
    lang_defs = {
        common = include "${cwd}/common/common.pbb";
        config = include "${cwd}/config/config.pbb";
        c = include "${cwd}/c/c.pbb";
        rust = include "${cwd}/rust/rust.pbb";
        tests = include "${cwd}/tests/tests.pbb";
    } // languages;
    merge = |mods l|
    let
        mods_evaled = [ |mod| mod l for mods ];
        # All language fields are listed
        zipped = { |(lang, vs)| (lang, ops.transposeObjs vs) for (ops.transposeObjs mods_evaled) };
    in
    {
        |(lang, langvars)|
        let
            def = lang_defs.{lang};
        in
        (
            lang,
            {
                |(field, vs)|
                let
                    mergefunc = def.merge.{field};
                in
                (field, (|a b| mergefunc a b for vs))
                for langvars
            }
        )
        for zipped
    };
    base = merge [ |(_, def)| def.base for lang_defs ];

    # Merge and combine all mods. This is what resolves all recursions
    combine = |mods| ops.recurse (merge ([base] ++ mods));


    # Build combines all modules and generates a build output
    build = |mods| (combine mods).common.out;

    # Test report combines all modules, all test-only modules and generates an
    # a test report
    test_multi_report = |output modss|
    let
        cases = (
            |prev mods|
            let
                self_base = combine (mods);
                self = combine (mods ++ self_base.tests.test_mods);
            in
            prev ++ (lang_defs.tests.test_cases self)
            for [] : modss
        );
    in
    lang_defs.tests.test_report { output; cases; };
    test_report = |output mods| test_multi_report output [mods];


    export = { |(lang, def)| (lang, def.export) for lang_defs if |(_, def)| def ? "export" };
    gate = |cond mod l| {
        |(k, v)| (
            k,
            switch (cond l) {
                false => { };
                true => v;
            }
        )
        for (mod l)
    };
in
{ combine; merge; build; test_multi_report; test_report; export; gate; }