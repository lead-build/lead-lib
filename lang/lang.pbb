|{ include, cwd, ops, ... } { languages, ... }|
let
    # Add predefined langauges
    lang_defs = {
        common = include "${cwd}/common/common.pbb";
        config = include "${cwd}/config/config.pbb";
        c = include "${cwd}/c/c.pbb";
        rust = include "${cwd}/rust/rust.pbb";
        tests = include "${cwd}/tests/tests.pbb";
    } // languages;
    merge = |mods l|
    let
        mods_evaled = [ |mod| mod l for mods ];
        # All language fields are listed
        zipped = { |(lang, vs)| (lang, ops.transposeObjs vs) for (ops.transposeObjs mods_evaled) };
    in
    {
        |(lang, langvars)|
        let
            def = lang_defs.{lang};
        in
        (
            lang,
            {
                |(field, vs)|
                let
                    mergefunc = def.merge.{field};
                in
                (field, (|a b| mergefunc a b for vs))
                for langvars
            }
        )
        for zipped
    };
    base = merge [ |(_, def)| def.base for lang_defs ];
    build = |mods|
    let
        all = merge ([base] ++ mods);
        self = ops.recurse all;
    in
    self.common.out;
    test_report = |output mods| lang_defs.tests.export.report output (merge mods);
    export = { |(lang, def)| (lang, def.export) for lang_defs if |(_, def)| def ? "export" };
    gate = |cond mod l| {
        |(k, v)| (
            k,
            switch (cond l) {
                false => { };
                true => v;
            }
        )
        for (mod l)
    };
in
{ merge; build; test_report; export; gate; }