|{ pb, ... }| {
    merge = {
        target_name = |a b| b;
        arch = |a b| b;
        variant = |a b| b;
        srcdirs = |a b| a ++ b;
        objbasedir = |a b| b;
        objdir = |a b| b;
        subdir = |a b| a ++ b;
        outdir = |a b| b;
    };
    base = |self| {
        config = {
            # target_name = ...
            arch = "posix";
            variant = "native";
            srcdirs = [];
            objbasedir = null;
            subdir = [];
            objdir = (
                |dir subdir| dir / subdir
                for (self.config.objbasedir) : (self.config.subdir)
            );
            outdir = null;
        };
    };
    export = {
        mod = |vars self| { config = vars; };
        simple = |base_dir self| {
            config = {
                srcdirs = [base_dir];
                objbasedir = base_dir / "build";
                outdir = base_dir / "out";
            };
        };
    };
}