|{ pb, ... }| {
    merge = {
        target_name = |a b| b;
        arch = |a b| b;
        variant = |a b| b;
        srcdirs = |a b| a ++ b;

        objbasedir = |a b| b;
        objdir = |a b| b;
        objsubdir = |a b| a ++ b;

        outbasedir = |a b| b;
        outdir = |a b| b;
        outsubdir = |a b| a ++ b;

        # List of enabled features, usable for lib.gate
        features = |a b| a ++ b;
        has_feature = |a b| b;
    };
    base = |self| {
        config = {
            # target_name = ...
            arch = "posix";
            variant = "native";
            srcdirs = [];

            objbasedir = null;
            objdir = (
                |dir objsubdir| dir / objsubdir
                for (self.config.objbasedir) : (self.config.objsubdir)
            );
            objsubdir = [];

            outbasedir = null;
            outdir = (
                |dir objsubdir| dir / objsubdir
                for (self.config.outbasedir) : (self.config.outsubdir)
            );
            outsubdir = [];

            features = [];

            has_feature = |feature| (
                |acc cur| (acc || cur == feature)
                for false : self.config.features
            );
        };
    };
    export = {
        mod = |vars self| { config = vars; };
        simple = |base_dir self| {
            config = {
                srcdirs = [base_dir];
                objbasedir = base_dir / "build";
                outbasedir = base_dir / "out";
            };
        };
        features = |features self| { config = { features; }; };
    };
}