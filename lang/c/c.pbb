|{ pb, ... }|
let
    tmpl_compile = |self|
    let
        { cmd_cc, cflags ? [], inc ? [], defines ? { }, extra_deps ? [], ... } = self.c;
        define_args = [ |(name, value)| "-D${name}=${value}" for defines ];
        include_args = [ |inc_dir| "-I${inc_dir}" for inc ];
        rule_compile = pb.rule (|{ input, output, ... }| {
            command = [
                cmd_cc,
                "-c",
                "-o",
                output,
                "-MMD",
                "-MF",
                "${output}.d",
                input,
            ] ++ cflags ++ define_args ++ include_args;
            depfile = "${output}.d";
            description = "CC ${cmd_cc} ${input}";
        });
        # Assembly that is not preprocessed: it includes nothing, and the
        # compiler writes no depfile for it
        rule_assemble = pb.rule (|{ input, output, ... }| {
            command = [cmd_cc, "-c", "-o", output, input,] ++ cflags ++ define_args ++ include_args;
            description = "AS ${cmd_cc} ${input}";
        });
        src_to_obj = |input| pb.translate {
            input;
            from = self.config.srcdirs;
            to = self.config.objdir;
        };
        compile = |rule suffix input| rule {
            input;
            output = (src_to_obj input) - suffix + ".o";
            deps = extra_deps;
        };
    in
    # C, assembly that is preprocessed (.S), and assembly that is not (.s)
    |input| switch true {
        (pb.matches "*.c" input) => compile rule_compile ".c" input;
        (pb.matches "*.S" input) => compile rule_compile ".S" input;
        (pb.matches "*.s" input) => compile rule_assemble ".s" input;
    };
    tmpl_link = |output self|
    let
        { cmd_ld, config_flags ? [], ldflags ? [], start_obj ? [], end_obj ? [], link_depfile ? false, ... } = self.c;
        # With link_depfile, the linker writes the files that it read, the
        # linker scripts and what they include among them, as the depfile of
        # the link, so that a program is linked again when one of them
        # changes: an option of lld, and of GNU ld from 2.40
        rule_link = pb.rule (|{ input, output, ... }| {
            command = [cmd_ld, "-o", output, input,] ++ config_flags ++ ldflags
                ++ switch link_depfile {
                    true => ["-Wl,--dependency-file=${output}.d",];
                    false => [];
                };
            description = "LD ${cmd_ld} ${output}";
        } // switch link_depfile {
            true => { depfile = "${output}.d"; };
            false => { };
        });
    in
    # The start objects come first on the link line and the end objects last,
    # as the start files of a compiler driver do (crt1.o crti.o ... crtn.o)
    |input| rule_link {
        input = start_obj ++ input ++ end_obj;
        output;
    };
    tmpl_reloc = |self|
    let
        { cmd_ld_reloc, reloc_flags ? [], ... } = self.c;
        rule_reloc = pb.rule (|{ input, output, ... }| {
            command = [cmd_ld_reloc,] ++ reloc_flags ++ ["-o", output, input,];
            description = "LD reloc ${cmd_ld_reloc} ${output}";
        });
        target_name = self.config.target_name;
    in
    |objs| rule_reloc {
        input = objs;
        output = self.config.outdir / "${target_name}.o";
    };
in
{
    merge = {
        cmd_cc = |a b| b;
        cmd_ld = |a b| b;
        cmd_ld_reloc = |a b| b;
        link_depfile = |a b| b;
        cflags = |a b| a ++ b;
        ldflags = |a b| a ++ b;
        reloc_flags = |a b| a ++ b;
        extra_deps = |a b| a ++ b;
        defines = |a b| a // b;
        inc = |a b| a ++ b;
        src = |a b| a ++ b;
        start_src = |a b| a ++ b;
        end_src = |a b| a ++ b;
        tests = |a b| a ++ b;
        obj = |a b| a ++ b;
        start_obj = |a b| a ++ b;
        end_obj = |a b| a ++ b;
        app = |a b| a ++ b;
        reloc = |a b| a ++ b;
    };
    base = |self| {
        c = {
            cmd_cc = "gcc";
            cmd_ld = "gcc";
            cmd_ld_reloc = "ld";
            link_depfile = false;
            cflags = [];
            ldflags = [];
            reloc_flags = [];
            extra_deps = [];
            defines = { };
            inc = [];
            src = [];
            start_src = [];
            end_src = [];
            tests = [];
            obj =
            let
                compile = tmpl_compile self;
            in
            [ |src_file| compile src_file for (self.c.src) ];
            start_obj =
            let
                compile = tmpl_compile self;
            in
            [ |src_file| compile src_file for (self.c.start_src) ];
            end_obj =
            let
                compile = tmpl_compile self;
            in
            [ |src_file| compile src_file for (self.c.end_src) ];
            app = [tmpl_link (self.config.outdir / self.config.target_name) self self.c.obj];
            reloc = [
                |_| {
                    c = {
                        inc = self.c.inc;
                        extra_deps = self.c.extra_deps;
                        obj = [tmpl_reloc self self.c.obj];
                        # Not relocated into the object: they stay where
                        # they are on the link line of whoever uses this
                        start_obj = self.c.start_obj;
                        end_obj = self.c.end_obj;
                    };
                    tests = self.tests;
                },
            ];
        };
        tests = {
            # Each test is built by the test report, not here. It is a function
            # taking for_test, which gives a copy of self with the test-only
            # mods added, so those only affect the test files.
            tests = [
                |test_file test_self|
                let
                    test_exec = pb.translate {
                        input = test_file - ".c";
                        from = test_self.config.srcdirs;
                        to = test_self.config.outdir / "testcases";
                    };
                    test_obj = tmpl_compile test_self test_file;
                in
                tmpl_link test_exec test_self (test_self.c.obj ++ [test_obj])
                for self.c.tests
            ];
        };
    };
    export = {
        # start_src and end_src are linked before and after all other objects
        # (the start files of C, such as crt1, crti and crtn), in the order
        # given. They are compiled like src.
        mod = |{
            inc ? [],
            src ? [],
            start_src ? [],
            end_src ? [],
            tests ? [],
            defines ? { },
            ...
        } _| { c = { inc; src; start_src; end_src; defines; tests; }; };
        config = |config _| { c = config; };
        app_build = |target_name self| {
            config = {
                target_name;
                subdir = [target_name];
            };
            common = { out = self.c.app; };
        };
        reloc_build = |target_name self| {
            config = {
                target_name;
                subdir = [target_name];
            };
            common = { out = self.c.reloc; };
        };
    };
}