|{ pb, ... }|
let
    tmpl_compile = | l |
    let
        {
            cmd_cc = cmd_cc_f,
            cflags ? (|l| []),
            inc ? (|l| []),
            defines ? (| l |{ }),
            ...
        } = l.c;

        cmd_cc = cmd_cc_f l;

        define_args = [
            | (name, value) | "-D${name}=${value}"
            for (defines l)
        ];
        include_args = [
            | include | "-I${include}"
            for (inc l)
        ];

        rule_compile = pb.rule (
            |{ input, output, ... }|
            {
                command = [
                    cmd_cc,
                    "-c",
                    "-o",
                    output,
                    "-MMD",
                    "-MF",
                    "${output}.d",
                    input,
                ] ++ (cflags l) ++ define_args ++ include_args;
                depfile = "${output}.d";
                description = "CC ${cmd_cc} ${input}";
            }
        );

        src_to_obj = | file | pb.translate {
            input = file;
            from = l.common.srcdirs l;
            to = l.common.objdir l;
        };
    in
    | file | pb.build
    {
        rule = rule_compile;
        input = file;
        output = (src_to_obj file) - ".c" + ".o";
    };

    tmpl_link = | config target |
    let
        {
            cmd_ld,
            common_flags ? [],
            ldflags ? [],
            ...
        } = config.c;
    in
    pb.rule (
        |{ input, output, ... }|
        {
            command = [
                cmd_ld,
                "-o",
                output,
                input,
            ] ++ common_flags ++ ldflags;
            description = "LD ${cmd_ld} ${output}";
        }
    );

    tmpl_reloc = | config target |
    let
        {
            cmd_ld_reloc,
            reloc_flags ? [],
            ...
        } = config.c;
    in
    pb.rule (
        |{ input, output, ... }|
        {
            command = [
                cmd_ld_reloc,
                "-o",
                output,
                input,
            ] ++ reloc_flags;
            description = "LD reloc ${cmd_ld_reloc} ${output}";
        }
    );

    build = | config target |
    let
        rule_cc = tmpl_compile config target;
        rule_link = tmpl_link config target;
        rule_reloc = tmpl_reloc config target;

        objdir = (
            | path subdir | path / subdir
            for (config.common.objdir)..(target.common.subdir)
        );

    in
    {
        cc = | file | pb.build
        {
            rule = rule_cc;
            input = file;
            output = src_to_obj file - ".c" + ".o";
        };
        cc_nomove = | file | pb.build
        {
            rule = rule_cc;
            input = file;
            output = file - ".c" + ".o";
        };
        as = | file | pb.build
        {
            rule = rule_cc;
            input = file;
            output = src_to_obj file - ".S" + ".o";
        };
        link = | output input | pb.build
        {
            rule = rule_link;
            input = input;
            output = output;
        };
        reloc = | output input | pb.build
        {
            rule = rule_reloc;
            input = input;
            output = output;
        };
    };

in
{
    merge = {
        cmd_cc = | a b l | (b l);
        cmd_ld = | a b l | (b l);
        cmd_ld_reloc = | a b l | (b l);
        cflags = | a b l | (a l) ++ (b l);
        ldflags = | a b l | (a l) ++ (b l);
        reloc_flags = | a b l | (a l) ++ (b l);

        defines = | a b l | (a l) // (b l);

        inc = | a b l | (a l) ++ (b l);
        src = | a b l | (a l) ++ (b l);
        obj = | a b l | (a l) ++ (b l);

        app = | a b l | (a l) ++ (b l);
    };

    base = {
        c = {
            cmd_cc = | l | "gcc";
            cmd_ld = | l | "gcc";
            cmd_ld_reloc = | l | "ld";
            cflags = | l | [];
            ldflags = | l | [];
            reloc_flags = | l | [];

            defines = | l |{ };

            inc = | l | [];
            src = | l | [];

            obj = | l |
            let
                compile = tmpl_compile l;
            in
            [
                | src_file | compile src_file
                for (l.c.src l)
            ];
            app = | l | [];
        };
    };

    build = build;
}