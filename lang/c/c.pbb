|{ pb, ... }|
let
    tmpl_compile = | l |
    let
        {
            cmd_cc = cmd_cc_f,
            cflags ? (|l| []),
            inc ? (|l| []),
            defines ? (| l |{ }),
            extra_deps = extra_deps_f ? (| l | []),
            ...
        } = l.c;

        cmd_cc = cmd_cc_f l;
        extra_deps = extra_deps_f l;

        define_args = [
            | (name, value) | "-D${name}=${value}"
            for (defines l)
        ];
        include_args = [
            | include | "-I${include}"
            for (inc l)
        ];

        rule_compile = pb.rule (
            |{ input, output, ... }|
            {
                command = [
                    cmd_cc,
                    "-c",
                    "-o",
                    output,
                    "-MMD",
                    "-MF",
                    "${output}.d",
                    input,
                ] ++ (cflags l) ++ define_args ++ include_args;
                depfile = "${output}.d";
                description = "CC ${cmd_cc} ${input}";
            }
        );

        src_to_obj = | file | pb.translate {
            input = file;
            from = l.common.srcdirs l;
            to = l.common.objdir l;
        };
    in
    | file | rule_compile
    {
        input = file;
        output = (src_to_obj file) - ".c" + ".o";
        deps = extra_deps;
    };

    tmpl_link = | l |
    let
        {
            cmd_ld = cmd_ld_f,
            common_flags ? (| l | []),
            ldflags ? (| l | []),
            ...
        } = l.c;

        cmd_ld = cmd_ld_f l;

        rule_link = pb.rule (
            |{ input, output, ... }|
            {
                command = [
                    cmd_ld,
                    "-o",
                    output,
                    input,
                ] ++ (common_flags l) ++ (ldflags l);
                description = "LD ${cmd_ld} ${output}";
            }
        );
    in
    | objs | rule_link {
        input = objs;
        output = (l.common.outdir l) / (l.common.target_name l);
    };

    tmpl_reloc = | l |
    let
        {
            cmd_ld_reloc = cmd_ld_reloc_f,
            reloc_flags ? (| l | []),
            ...
        } = l.c;

        cmd_ld_reloc = cmd_ld_reloc_f l;

        rule_reloc = pb.rule (
            |{ input, output, ... }|
            {
                command = [
                    cmd_ld_reloc,
                    "-o",
                    output,
                    input,
                ] ++ (reloc_flags l);
                description = "LD reloc ${cmd_ld_reloc} ${output}";
            }
        );

        target_name = l.common.target_name l;
    in
    | objs | rule_reloc {
        input = objs;
        output = (l.common.outdir l) / "${target_name}.o";
    };
in
{
    merge = {
        cmd_cc = | a b l | (b l);
        cmd_ld = | a b l | (b l);
        cmd_ld_reloc = | a b l | (b l);
        cflags = | a b l | (a l) ++ (b l);
        ldflags = | a b l | (a l) ++ (b l);
        reloc_flags = | a b l | (a l) ++ (b l);

        extra_deps = | a b l | (a l) ++ (b l);

        defines = | a b l | (a l) // (b l);

        inc = | a b l | (a l) ++ (b l);
        src = | a b l | (a l) ++ (b l);
        obj = | a b l | (a l) ++ (b l);

        app = | a b l | (a l) ++ (b l);
        reloc = | a b l | (a l) ++ (b l);
    };

    base = {
        c = {
            cmd_cc = | l | "gcc";
            cmd_ld = | l | "gcc";
            cmd_ld_reloc = | l | "ld";
            cflags = | l | [];
            ldflags = | l | [];
            reloc_flags = | l | [];

            extra_deps = | l | [];

            defines = | l |{ };

            inc = | l | [];
            src = | l | [];

            obj = | l |
            let
                compile = tmpl_compile l;
            in
            [
                | src_file | compile src_file
                for (l.c.src l)
            ];

            app = | l | [
                tmpl_link l (l.c.obj l)
            ];
            reloc = | l | [
                {
                    c = {
                        inc = let
                            res = l.c.inc l;
                        in
                        | _ | res;
                        obj = let
                            res = [ tmpl_reloc l (l.c.obj l) ];
                        in
                        | _ | res;
                    };
                },
            ];
        };
    };

    export = {
        mod = |{
            inc ? [],
            src ? [],
            defines ? { },
            ...
        }|{
            c = {
                inc = | l | inc;
                src = | l | src;
                defines = | l | defines;
            };
        };
        app_build = | target_name |{
            common = {
                target_name = | l | target_name;
                subdir = | l | [ target_name ];
                out = | l | (l.c.app l);
            };
        };
        reloc_build = | target_name |{
            common = {
                target_name = | l | target_name;
                subdir = | l | [ target_name ];
                out = | l | (l.c.reloc l);
            };
        };
    };
}