|{ pb, ... }|
let
    tmpl_crate = |flags| pb.rule (|{ name, input, output, target_dir, header_file, depfile, }| {
        command = [
            "CBINDGEN_HEADER_OUTPUT=${header_file}",
            "cargo",
            "build",
            "--manifest-path",
            input,
            "--target-dir",
            target_dir,
            "--release",
        ] ++ flags;
        pool = "console";
        depfile = depfile;
        description = "CARGO ${input}";
    });
    reloc_archive = |self|
    let
        # Borrow relocation info from c
        { cmd_ld_reloc, ... } = self.c;
        rule_reloc = pb.rule (|{ input, output, ... }| {
            command = [
                cmd_ld_reloc,
                "-r",
                # TODO: Better handling of flags
                "--whole-archive",
                "-o",
                output,
                input,
            ];
            description = "LD reloc ${cmd_ld_reloc} ${output}";
        });
    in
    |archive| rule_reloc {
        input = archive;
        output = archive - ".a" + ".o";
    };
    build_crate = |{ outdir, objdir, target }|
    let
        flags = switch target {
            false => [];
            target => ["--target=${target}"];
        };
        subdir = switch target {
            false => "release";
            target => "${target}/release";
        };
        rule_crate = tmpl_crate flags;
    in
    |{ name, dir, ... }|
    let
        target_dir = "${objdir}/${name}";
        header_file = "${target_dir}/${subdir}/${name}.h";
        archive_file = "${target_dir}/${subdir}/lib${name}.a";
        depfile = "${target_dir}/${subdir}/lib${name}.d";
    in
    rule_crate {
        name; header_file; depfile; target_dir;
        input = "${dir}/Cargo.toml";
        output = { header_file; archive_file; };
    };
in
{
    merge = {
        target = |a b| b;
        crates = |a b| a ++ b;
        obj = |a b| a ++ b;
    };
    base = |self| {
        rust = {
            target = false;
            crates = [];
            obj = [
                build_crate {
                    outdir = self.config.outdir;
                    objdir = self.config.objdir;
                    target = self.rust.target;
                }
                for (self.rust.crates)
            ];
        };
        c = {
            inc = [ |crate| crate.header_file / ".." for (self.rust.obj) ];
            extra_deps = [ |crate| crate.header_file for (self.rust.obj) ];
            obj =
            let
                reloc = reloc_archive self;
            in
            [ |crate| reloc crate.archive_file for (self.rust.obj) ];
        };
    };
    export = {
        mod = |{ name, dir }| |self| {
            rust = {
                crates = [
                    {
                        name = name;
                        dir = dir;
                    }
                ];
            };
        };
    };
}